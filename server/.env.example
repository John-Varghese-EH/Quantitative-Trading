# ── App ──────────────────────────────────────────────────────────
APP_NAME="QuantAdv Sandbox"
APP_VERSION="1.0.0"
DEBUG=False
ENVIRONMENT="production"

# ── Security ─────────────────────────────────────────────────────
SECRET_KEY="replace-this-with-a-very-long-random-string-in-production"
ALGORITHM="HS256"

# ── Database (Firebase) ──────────────────────────────────────────
# Set this to the JSON string contents of your service account key, 
# or a path to the file. Render supports Secret Files where you can 
# upload serviceAccountKey.json and reference its path here.
FIREBASE_SERVICE_ACCOUNT_PATH="/etc/secrets/serviceAccountKey.json"
FIREBASE_PROJECT_ID="your-firebase-project-id"

# ── CORS ─────────────────────────────────────────────────────────────
# Add your Vercel frontend URL here when deployed
ALLOWED_ORIGINS_STR="http://localhost:3000,https://your-vercel-app-url.vercel.app"

# ── External APIs ────────────────────────────────────────────────
ALPHA_VANTAGE_API_KEY=""
BINANCE_API_KEY=""
BINANCE_API_SECRET=""
NEWS_API_KEY=""

# ── Email ────────────────────────────────────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="noreply@quantadv.io"
MOCK_EMAIL=True
