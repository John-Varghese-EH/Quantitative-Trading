# ========================================
# Application
# ========================================
APP_NAME=QuantAdv Sandbox
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development

# ========================================
# Security
# ========================================
SECRET_KEY=change-this-to-a-very-long-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ========================================
# Database
# ========================================
POSTGRES_USER=quantadv
POSTGRES_PASSWORD=quantadv_password
POSTGRES_DB=quantadv
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://quantadv:quantadv_password@localhost:5432/quantadv

# ========================================
# CORS
# ========================================
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ========================================
# External APIs (Optional)
# ========================================
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here
NEWS_API_KEY=your_news_api_key_here

# ========================================
# Email (Mock by default)
# ========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=noreply@quantadv.io
MOCK_EMAIL=true

# ========================================
# Admin
# ========================================
ADMIN_EMAIL=admin@quantadv.io
ADMIN_PASSWORD=Admin@123456

# ========================================
# Cache
# ========================================
CACHE_TTL_SECONDS=300
